        "# ==========================================\n",
        "# MODUL 2: PEMROSESAN DATA (Dikerjakan Anggota B)\n",
        "# ==========================================\n",
        "def hitung_total_penjualan(data):\n",
        "    subtotal = data[\"harga\"] * data[\"jumlah\"]\n",
        "\n",
        "    # Logika bisnis: Diskon 10% jika transaksi > Rp 100.000\n",
        "    if subtotal > 100000:\n",
        "        diskon = subtotal * 0.10\n",
        "    else:\n",
        "        diskon = 0\n",
        "\n",
        "    total_bayar = subtotal - diskon\n",
        "\n",
        "    return {\n",
        "        \"subtotal\": subtotal,\n",
        "        \"diskon\": diskon,\n",
        "        \"total_bayar\": total_bayar\n",
        "    }"
      ]
    }
